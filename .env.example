# Copy to .env and fill in. .env is never committed.

# Bearer token clients send as "Authorization: Bearer <token>".
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
HUB_TOKEN=

# Host interface and port to publish (compose only).
HUB_BIND=0.0.0.0
HUB_PORT=3000

# Comma-separated https:// prefixes that may be registered.
HUB_ALLOWED_REPOS=https://github.com/

# Seconds between automatic refreshes of every project (0 = off).
HUB_REFRESH_INTERVAL=900

# Limits.
HUB_BUILD_TIMEOUT=900
HUB_MAX_REPO_MB=500
HUB_MAX_CONTEXTS=8
HUB_BUILD_WORKERS=2
